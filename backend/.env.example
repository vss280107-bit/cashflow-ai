# SQLite works out of the box. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://cashflow:cashflow@localhost:5432/cashflow
DATABASE_URL=sqlite:///./cashflow.db
SECRET_KEY=change-me-to-a-long-random-string
# Optional Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# If empty, a key is derived from SECRET_KEY.
FIELD_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
